# Copy to .dev.vars for Wrangler local development. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_ID=
# Opt in: financial text leaves Telegram/Cloudflare for the configured provider.
AI_ENABLED=false
AI_ORDER=rules,cloudflare,gemma,gemini,groq,openrouter
AI_DAILY_LIMIT=20
GEMMA_API_KEY=
GEMMA_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
CLOUDFLARE_AI_MODEL=
